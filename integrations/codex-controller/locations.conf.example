# Internal auth uses the main controller's native admin-only endpoint.
location = /_codex_console_admin {
    internal;
    proxy_pass http://127.0.0.1:18787/api/panel/users;
    proxy_method GET;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Panel-Token $http_x_panel_token;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
}
location ^~ /api/panel/codex-controller/ {
    if ($codex_console_origin_ok = 0) { return 403; }
    if ($codex_console_csrf_ok = 0) { return 403; }
    auth_request /_codex_console_admin;
    client_max_body_size 8m;
    client_body_buffer_size 64k;
    limit_req zone=vm2api_api_direct burst=60 nodelay;
    limit_conn vm2api_clients_direct 64;
    proxy_pass http://127.0.0.1:33681/api/panel/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization "Bearer __CODEX_MASTER__";
    proxy_set_header X-Panel-Token "";
    proxy_set_header Cookie "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $vm2api_upgrade;
    proxy_hide_header Set-Cookie;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 600s;
    proxy_send_timeout 60s;
}
