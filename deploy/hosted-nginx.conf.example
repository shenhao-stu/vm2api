map $http_upgrade $hosted_connection_upgrade {
    default upgrade;
    '' close;
}

# Dedicated HTTPS entry; install alongside existing virtual hosts.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hosted.example.com;
    ssl_certificate /etc/letsencrypt/live/hosted.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hosted.example.com/privkey.pem;
    client_max_body_size 128m;
    location / {
        proxy_pass http://127.0.0.1:18888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hosted_connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
